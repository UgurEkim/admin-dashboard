# Current Docker deployment is localhost-only until authentication is implemented.
APP_URL=http://localhost:8080
APP_PORT=8080
ALLOW_UNAUTHENTICATED_LOCAL=true
POSTGRES_PASSWORD=repair
# Use the Compose service hostname, not localhost, for containers.
# URL-encode special characters in the password in this URL.
DOCKER_DATABASE_URL=postgresql://repair:repair@db:5432/repair_admin

